# Cloudflare Pages headers file.
# Next copies /public verbatim into /out, so this ships with the build.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Hashed build assets never change under the same name — cache them forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The OG image is emitted without a file extension, so Cloudflare would
# otherwise guess application/octet-stream and some scrapers would skip it.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400

# The Response headers set in app/llms.txt/route.ts are discarded when the
# route is flattened into a static file, so the caching policy lives here.
# Short max-age: this is the copy answer engines re-fetch to stay current.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: all

# No Content-Disposition here on purpose: opening the URL directly renders in
# the browser's PDF viewer, while the `download` attribute on the résumé link
# still saves the file. Short max-age so a replaced résumé goes live same day.
/Hammad-Ur-Rehman-AI-Engineer.pdf
  Content-Type: application/pdf
  Cache-Control: public, max-age=3600, must-revalidate

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
